rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile and settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Goals Subcollection
      match /goals/{goalId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Modules Subcollection
      match /modules/{moduleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(moduleId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Resources Subcollection
      match /resources/{resourceId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resourceId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Learning Sessions Subcollection
      match /sessions/{sessionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Website Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
